{
  "name": "Plume",
  "scopeName": "source.plume",
  "fileTypes": ["plume", "🪶"],
  "patterns": [
    { "include": "#command" }
  ],
  "repository": {
    "command": {
      "patterns": [
        { "match": "\\s+" },
        { "begin": "\\blet\\b", "beginCaptures": { "0": { "name": "storage.declaration.plume" } }, "end": "(\\+|\\*|\\/|\\-)?=", "endCaptures": { "0": { "name": "keyword.operator.plume" } }, "patterns": [
          { "match": "\\s" },
          { "match": "\\b(const|param)\\b", "name": "storage.type.declaration.plume" },
          { "include": "#let_destructuration" },
          { "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b", "name": "meta.mapping.key.plume" }
        ] },
        { "begin": "\\bset\\b", "beginCaptures": { "0": { "name": "storage.declaration.plume" } }, "end": "(\\+|\\*|\\/|\\-)?=", "endCaptures": { "0": { "name": "keyword.operator.plume" } }, "patterns": [
          { "match": "\\s" },
          { "include": "#let_destructuration" },
          { "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b\\s*(?=\\[)", "name": "meta.mapping.key.plume", "push": "eval_set" },
          { "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b", "name": "meta.mapping.key.plume" }
        ] },
        { "begin": "\\b(if|elseif|while|for)\\s*\\b", "beginCaptures": { "0": { "name": "keyword.operator.plume" } }, "end": "$", "patterns": [ { "include": "#script" } ] },
        { "match": "\\b(else|leave|end|break|continue)\\b", "name": "keyword.operator.plume" },
        { "match": "\\b(run|do|raise|return)\\b", "name": "keyword.operator.plume" },
        { "begin": "\\b(raw)\\b", "beginCaptures": { "0": { "name": "keyword.operator.plume" } }, "end": "\\bend\\b", "endCaptures": { "0": { "name": "keyword.operator.plume" } }, "patterns": [] },
        { "begin": "(\\buse\\b)((\\s+#[^\\s\\(\\)]+)|(\\s+[^\\s\\(\\)]+))?", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "3": { "name": "keyword.operator.plume" } }, "end": "$", "patterns": [ { "include": "#with" } ] },
        { "begin": "(\\bwith\\b)", "beginCaptures": { "0": { "name": "keyword.operator.plume" } }, "end": "$", "patterns": [ { "include": "#with" } ] },
        { "begin": "(\\bmacro\\b)(\\s+[a-zA-Z_][a-zA-Z0-9_]*)?\\s*\\(", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "entity.name.function.plume" } }, "end": "\\)", "patterns": [ { "include": "#macro_def_arg_list" } ] },
        { "match": "(\\bmacro\\b)(\\s+[a-zA-Z_][a-zA-Z0-9_]*)?", "captures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "entity.name.function.plume" } } },
        { "match": "\\-", "name": "keyword.operator.plume" },
        { "begin": "(\\.\\.\\.)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "meta.mapping.key.plume" } }, "end": "(?=[^\\w.\\[(])", "patterns": [ { "include": "#eval" } ] },
        { "match": "(meta\\s+|ref\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)", "captures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "meta.mapping.key.plume" }, "3": { "name": "keyword.operator.plume" } } },
        { "match": "(ref)\\s+([a-zA-Z_][a-zA-Z0-9_]*)", "captures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "meta.mapping.key.plume" } } },
        { "begin": "\\$ ", "beginCaptures": { "0": { "name": "keyword.operator.plume" } }, "end": "$", "patterns": [ { "include": "#script" } ] },
        { "begin": "\\(", "end": "\\)", "patterns": [ { "include": "#macro_call_param_list" } ] },
        { "match": "//.*", "name": "comment.plume" },
        { "begin": "/\\*", "beginCaptures": { "0": { "name": "comment.plume" } }, "end": "\\*/", "endCaptures": { "0": { "name": "comment.plume" } }, "patterns": [ { "match": ".", "name": "comment.plume" } ] },
        { "match": "(\\$)(true|false|empty)", "captures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "constant.numeric.plume" } } },
        { "begin": "(\\$)([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "entity.name.function.call.plume" } }, "end": "\\)", "patterns": [ { "include": "#macro_call_param_list" } ] },
        { "begin": "(\\$)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "meta.mapping.key.plume" } }, "end": "(?=[^\\w.\\[(])", "patterns": [ { "include": "#eval" } ] },
        { "begin": "(\\$)([0-9]+.?[0-9]+)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "constant.numeric.plume" } }, "end": "(?=[^\\w.\\[(])", "patterns": [ { "include": "#eval" } ] },
        { "begin": "(\\@)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "entity.name.function.call.plume" } }, "end": "(?=[^\\w.\\[(])", "patterns": [ { "include": "#eval" } ] },
        { "begin": "(\\$)(\\()", "beginCaptures": { "1": { "name": "keyword.operator.plume" } }, "end": "\\)", "patterns": [ { "include": "#eval_script" } ] },
        { "begin": "(?=.)", "end": "$", "patterns": [ { "include": "#text" } ] }
      ]
    },
    "with": {
      "patterns": [
        { "match": "([a-zA-Z_][a-zA-Z0-9_]*)(:)\\s*([0-9a-zA-Z]+)", "captures": { "1": { "name": "meta.mapping.key.plume" }, "2": { "name": "punctuation.plume" }, "3": { "name": "storage.declaration.plume" } } },
        { "match": "\\s*,\\s*", "name": "punctuation.plume" }
      ]
    },
    "text": {
      "patterns": [
        { "match": "(\\\\n|\\\\t|\\\\r|\\\\s|\\\\\\$|\\\\\\(|\\\\\\)|\\\\:|\\\\,|\\\\\\\\|\\\\/|\\\\0)", "name": "string" },
        { "match": "\\\\.", "name": "invalid" },
        { "match": "//.*", "name": "comment.plume" },
        { "begin": "/\\*", "beginCaptures": { "0": { "name": "comment.plume" } }, "end": "\\*/", "endCaptures": { "0": { "name": "comment.plume" } }, "patterns": [ { "match": ".", "name": "comment.plume" } ] },
        { "match": "(\\$)(true|false|empty)", "captures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "constant.numeric.plume" } } },
        { "begin": "(\\$)([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "entity.name.function.call.plume" } }, "end": "\\)", "patterns": [ { "include": "#macro_call_param_list" } ] },
        { "begin": "(\\$)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "meta.mapping.key.plume" } }, "end": "(?=[^\\w.\\[(])", "patterns": [ { "include": "#eval" } ] },
        { "begin": "(\\$)([0-9]+.?[0-9]+)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "constant.numeric.plume" } }, "end": "(?=[^\\w.\\[(])", "patterns": [ { "include": "#eval" } ] },
        { "begin": "(\\@)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "entity.name.function.call.plume" } }, "end": "(?=[^\\w.\\[(])", "patterns": [ { "include": "#eval" } ] },
        { "begin": "(\\$)(\\()", "beginCaptures": { "1": { "name": "keyword.operator.plume" } }, "end": "\\)", "patterns": [ { "include": "#eval_script" } ] },
        { "match": "." }
      ]
    },
    "comment": {
      "patterns": [
        { "match": ".", "name": "comment.plume" }
      ]
    },
    "script": {
      "patterns": [
        { "match": "\\s+" },
        { "match": "\".*?\"", "name": "string" },
        { "match": "[+\\-*/%<>!=^]+", "name": "keyword.operator.plume" },
        { "begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\(", "beginCaptures": { "1": { "name": "entity.name.function.call.plume" } }, "end": "\\)", "patterns": [ { "include": "#script" } ] },
        { "begin": "([a-zA-Z_][a-zA-Z0-9_]*)(:)", "beginCaptures": { "1": { "name": "variable.parameter.function.plume" }, "2": { "name": "keyword.operator.plume" } }, "end": "$", "patterns": [ { "include": "#script" } ] },
        { "match": "\\b(\\d+(\\.\\d+)?|true|false|empty)\\b", "name": "constant.numeric.plume" },
        { "match": "\\b(or|and|in|not)\\b", "name": "keyword.operator.plume" },
        { "begin": "\\(", "end": "\\)", "patterns": [ { "include": "#script" } ] }
      ]
    },
    "eval": {
      "patterns": [
        { "begin": "\\[", "end": "(\\])(\\??)", "endCaptures": { "1": { "name": "punctuation.parenthesis.end.plume" }, "2": { "name": "keyword" } }, "patterns": [ { "include": "#script" } ] },
        { "begin": "\\(", "beginCaptures": { "0": { "name": "punctuation.plume" } }, "end": "\\)", "patterns": [ { "include": "#macro_call_param_list" } ] },
        { "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(\\??)", "captures": { "1": { "name": "punctuation.plume" }, "2": { "name": "meta.mapping.key.plume" }, "3": { "name": "keyword" } } }
      ]
    },
    "let_destructuration": {
      "patterns": [
        { "match": "(\\b[a-zA-Z_][a-zA-Z0-9_]*\\b)\\s+(as)\\s+(\\b[a-zA-Z_][a-zA-Z0-9_]*\\b)", "captures": { "1": { "name": "meta.mapping.key.plume" }, "2": { "name": "keyword.operator.plume" }, "3": { "name": "meta.mapping.key.plume" } } },
        { "begin": ":", "end": "$", "patterns": [ { "include": "#text" } ] }
      ]
    },
    "eval_set": {
      "patterns": [
        { "begin": ",", "end": "$", "patterns": [ { "include": "#set_begin" } ] },
        { "include": "#eval" }
      ]
    },
    "text_from": {
      "patterns": [
        { "begin": ",", "end": "$", "patterns": [ { "include": "#let_value" } ] },
        { "include": "#text" }
      ]
    },
    "eval_script": {
      "patterns": [
        { "include": "#script" }
      ]
    },
    "macro_def_arg_list": {
      "patterns": [
        { "begin": "([a-zA-Z_][a-zA-Z0-9_]*\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)(:)", "beginCaptures": { "1": { "name": "storage.type.plume" }, "2": { "name": "variable.parameter.function.plume" }, "3": { "name": "keyword.operator.plume" } }, "end": "(?=(\\)|,))", "patterns": [ { "include": "#param_value" } ] },
        { "begin": "([a-zA-Z_][a-zA-Z0-9_]*\\s+)?(\\.\\.\\.)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "storage.type.plume" }, "2": { "name": "keyword.operator.plume" }, "3": { "name": "variable.parameter.function.plume" } }, "end": "(?=(\\)|,))", "patterns": [ { "include": "#new_parameter_or_end" } ] },
        { "begin": "(\\?)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "variable.parameter.function.plume" } }, "end": "(?=(\\)|,))", "patterns": [ { "include": "#new_parameter_or_end" } ] },
        { "begin": "([a-zA-Z_][a-zA-Z0-9_]*\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "storage.type.plume" }, "2": { "name": "variable.parameter.function.plume" } }, "end": "(?=(\\)|,))", "patterns": [ { "include": "#new_parameter_or_end" } ] },
        { "match": "\\s" },
        { "match": ",", "name": "punctuation.plume" }
      ]
    },
    "macro_call_param_list": {
      "patterns": [
        { "begin": "([a-zA-Z_][a-zA-Z0-9_]*)(:)", "beginCaptures": { "1": { "name": "variable.parameter.function.plume" }, "2": { "name": "keyword.operator.plume" } }, "end": "(?=(\\)|,))", "patterns": [ { "include": "#param_value" } ] },
        { "begin": "(\\.\\.\\.)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "variable.parameter.function.plume" } }, "end": "(?=(\\)|,))", "patterns": [ { "include": "#new_parameter_or_end_eval" } ] },
        { "begin": "(\\?)([a-zA-Z_][a-zA-Z0-9_]*)", "beginCaptures": { "1": { "name": "keyword.operator.plume" }, "2": { "name": "variable.parameter.function.plume" } }, "end": "(?=(\\)|,))", "patterns": [ { "include": "#new_parameter_or_end" } ] },
        { "match": "\\s" }
      ]
    },
    "rawBlock": {
      "patterns": []
    },
    "new_parameter_or_end": {
      "patterns": [
        { "match": ",", "name": "punctuation.plume" },
        { "match": "\\s" },
        { "match": ".", "name": "invalid" }
      ]
    },
    "script_if": {
      "patterns": [
        { "include": "#script" }
      ]
    },
    "script_bracket": {
      "patterns": [
        { "include": "#script" }
      ]
    },
    "new_parameter_or_end_param": {
      "patterns": [
        { "include": "#new_parameter_or_end" }
      ]
    },
    "text_param": {
      "patterns": [
        { "include": "#text" }
      ]
    },
    "param_value": {
      "patterns": [
        { "include": "#text" }
      ]
    },
    "new_parameter_or_end_eval": {
      "patterns": [
        { "begin": "\\[", "end": "(\\])(\\??)", "endCaptures": { "1": { "name": "punctuation.parenthesis.end.plume" }, "2": { "name": "keyword" } }, "patterns": [ { "include": "#script" } ] },
        { "begin": "\\(", "beginCaptures": { "0": { "name": "punctuation.plume" } }, "end": "\\)", "patterns": [ { "include": "#macro_call_param_list" } ] },
        { "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(\\??)", "captures": { "1": { "name": "punctuation.plume" }, "2": { "name": "meta.mapping.key.plume" }, "3": { "name": "keyword" } } }
      ]
    }
  }
}
